      ]
    },
    {
      "parameters": {
        "jsCode": "const a = $json.analysis;\nconst template = {direct_meds:[{variation:1,hook:'',body:'',cta:'',higgsfield_prompt:''},{variation:2,hook:'',body:'',cta:'',higgsfield_prompt:''},{variation:3,hook:'',body:'',cta:'',higgsfield_prompt:''}],medvi:[{variation:1,hook:'',body:'',cta:'',higgsfield_prompt:''},{variation:2,hook:'',body:'',cta:'',higgsfield_prompt:''},{variation:3,hook:'',body:'',cta:'',higgsfield_prompt:''}],trimrx:[{variation:1,hook:'',body:'',cta:'',higgsfield_prompt:''},{variation:2,hook:'',body:'',cta:'',higgsfield_prompt:''},{variation:3,hook:'',body:'',cta:'',higgsfield_prompt:''}]};\nconst prompt = `You are an expert direct response copywriter for GLP-1 weight loss ads.\\n\\nOriginal ad:\\nHook: ${a.hook}\\nBody: ${a.body_copy}\\nCTA: ${a.cta}\\nAngle: ${a.ad_angle}\\nBenefit: ${a.key_benefit}\\nAudience: ${a.target_audience}\\n\\nCreate 9 variations \\u2014 3 per brand. Each needs: hook (max 10 words), body (max 50 words), cta (max 5 words), higgsfield_prompt (detailed image gen prompt referencing visual style: ${a.visual_style}, 4x5 ratio, brand appropriate).\\n\\nBRAND 1 - DIRECT MEDS: Prescription meds to door. Clinical, doctor-led tone. Adults 35-60.\\nBRAND 2 - MEDVI: Personalized GLP-1 plans, 24/7 support. Warm, supportive tone. Adults who tried everything.\\nBRAND 3 - TRIMRX: Affordable GLP-1 prescriptions. Bold, direct, value tone. Cost-conscious adults.\\n\\nReturn ONLY valid JSON:\\n${JSON.stringify(template)}`;\nconst requestBody = JSON.stringify({model:'anthropic/claude-opus-4-5',max_tokens:4000,messages:[{role:'user',content:prompt}]});\nreturn [{ json: { ...$json, requestBody } }];"
      },
