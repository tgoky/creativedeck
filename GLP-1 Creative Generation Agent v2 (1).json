        "jsCode": "const response = $input.first().json;\nconst files = response.files || [];\nconst meta = $('Split — Direct Meds').item.json;\nlet logoUrl = null, productUrl = null;\nfor (const f of files) {\n  const n = (f.name||'').toLowerCase();\n  if(n.includes('logo')) logoUrl=`https://drive.google.com/uc?export=download&id=${f.id}`;\n  if(n.includes('product')) productUrl=`https://drive.google.com/uc?export=download&id=${f.id}`;\n}\nconst imagesList = [meta.imageUrl];\nif(meta.has_logo && logoUrl) imagesList.push(logoUrl);\nif(meta.has_product && productUrl) imagesList.push(productUrl);\nreturn [{ json: { ...meta, logoUrl, productUrl, imagesList } }];"
