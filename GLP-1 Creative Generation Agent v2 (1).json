      "parameters": {
        "jsCode": "// Merge all 9 uploaded items and build doc content\nconst allItems = $input.all();\nconst first = $('Parse Ad Analysis1').first().json;\nconst now = new Date();\nconst timestamp = now.toLocaleString('en-US', { timeZone: 'America/New_York' });\n\nconst dmItems = $('DM — Extract Image URL').all();\nconst mvItems = $('MV — Extract Image URL').all();\nconst trItems = $('TR — Extract Image URL').all();\n\nlet doc = `GLP-1 AD CREATIVE BATCH\\nGenerated: ${timestamp}\\nSource: ${first.fileName}\\nOriginal Hook: ${first.analysis.hook}\\nAngle: ${first.analysis.ad_angle}\\n\\n${'='.repeat(60)}\\n\\n`;\n\nconst buildSection = (label, items) => {\n  let s = `${label}\\n${'─'.repeat(40)}\\n\\n`;\n  for (const item of items) {\n    s += `Variation ${item.json.variation}\\nHook: ${item.json.hook}\\nBody: ${item.json.body}\\nCTA: ${item.json.cta}\\nHiggsfield Prompt:\\n${item.json.higgsfield_prompt}\\nImage: ${item.json.generatedImageUrl}\\n\\n`;\n  }\n  return s;\n};\n\ndoc += buildSection('DIRECT MEDS', dmItems);\ndoc += buildSection('MEDVI', mvItems);\ndoc += buildSection('TRIMRX', trItems);\n\nreturn [{ json: { ...first, docContent: doc, timestamp, docTitle: `GLP-1 Creatives — ${first.folderName}` } }];"
      },
